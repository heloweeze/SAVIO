# Copier en .env et adapter les valeurs
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-please-32-chars-minimum-xxxxxxxxxxxxxx
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Indian/Reunion
DJANGO_LANGUAGE_CODE=fr

# Base de données (SQLite par défaut, laisser vide pour SQLite)
DATABASE_URL=

# Email (console en dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SAVIO <no-reply@savio.local>

# ---------------------------------------------------------------------------
# Assistant IA local (Python stdlib uniquement)
# ---------------------------------------------------------------------------
# Aucune dépendance externe — l'assistant fonctionne avec des règles et de la
# détection de mots-clés en pur Python. Activé par défaut. Mettre à 0 pour
# le désactiver complètement (les vues renverront « Assistant désactivé »).
ASSISTANT_ENABLED=1
